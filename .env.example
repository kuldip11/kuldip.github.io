# Canonical public URL used for metadata, sitemap, robots.txt, Open Graph, etc.
# Example:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Controls whether the Articles feature is publicly available.
# true  = Articles navigation, pages, sitemap entries, and article content are enabled.
# false = Articles are hidden and /articles routes return 404.
NEXT_PUBLIC_ARTICLES_ENABLED=true

# Gemini API key used by the portfolio assistant.
# Server-only. Do not expose this through NEXT_PUBLIC_*.
GEMINI_API_KEY=

# HMAC secret used to sign short-lived chat state/session tokens.
# Use a long random value in production.
CHAT_SESSION_SECRET=

# Optional private assistant trigger phrases.
# Comma-separated values.
# Example:
# SECRET_TEXT=private mode,unlock private,open private
SECRET_TEXT=

# Optional private assistant challenge/answer.
SECRET_CODE=

# Optional server-only instructions used after private mode is unlocked.
PRIVATE_CHATBOT_INSTRUCTIONS=

# Optional search-engine ownership verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=